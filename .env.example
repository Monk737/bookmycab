# Supabase
# Note: BookMyCab uses invite-only access (no public signup). To test auth
# flows locally, use Supabase's built-in Inbucket email UI at
# http://127.0.0.1:54324 to receive invite/password-reset emails.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Channel-credentials vault key (server-only). Symmetric key used to encrypt/
# decrypt channel secrets via the pgcrypto vault. NEVER exposed to the client.
# Production: source from the secret manager. Local dev: defaults if unset.
SUPABASE_VAULT_KEY=local-dev-vault-key-change-me

# Automation engine (n8n) — internal only, never exposed to customers.
# Local: docker-compose.engine.yml exposes n8n at http://localhost:5678.
# Generate an API key in n8n Settings → n8n API, then set:
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@bookmycab.com

# Redis (Upstash REST). Local: serverless-redis-http (SRH) from docker-compose.engine.yml.
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=local-dev-srh-token

# Gateway / demo / internal
WEBHOOK_RATE_LIMIT_PER_MIN=60

# Gateway tuning
CHANNEL_CACHE_TTL_SEC=300        # channel→automation resolver cache TTL (PRD: 5 min)
IDEMPOTENCY_TTL_SEC=86400        # inbound message dedupe window (24h)
DEMO_TENANT_ID=
FLOWMO_STAFF_EMAIL_DOMAIN=flowmoai.com

# Marketing
NEXT_PUBLIC_CAL_LINK=flowmo/discovery
NEXT_PUBLIC_SITE_URL=https://bookmycab.com

# Tests only (defaults to local supabase if unset)
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
