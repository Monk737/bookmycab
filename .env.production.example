# ───────────────────────────────────────────────────────────────────────────
# BookMyCab — production env. Copy to .env.production and fill the <…> values:
#   cp .env.production.example .env.production && nano .env.production
#   docker compose --env-file .env.production up -d --build
#
# RULES:
#   • NEXT_PUBLIC_* are inlined into the browser bundle at BUILD time (passed as
#     build args in docker-compose.yml). Change one → you MUST rebuild (--build),
#     a restart is not enough.
#   • Everything else is server-only and read at runtime (env_file). Changing one
#     only needs `docker compose --env-file .env.production up -d` (no rebuild).
#   • NEVER commit this filled-in file. Only this .example is tracked.
#   • DO NOT wrap values in quotes. Docker Compose's env_file keeps quotes
#     literally, so VALUE="https://x" becomes the string "https://x" (with the
#     quotes) and URL validation fails. Write:  KEY=https://x   not  KEY="https://x"
# ───────────────────────────────────────────────────────────────────────────

# --- Supabase (hosted; same project as dev unless you run a separate prod one) ---
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>      # server-only, secret
# Symmetric key for the channel-credentials vault (server-only). Generate a long
# random string, e.g.  openssl rand -hex 32
SUPABASE_VAULT_KEY=<random-32-byte-hex>

# --- Automation engine (n8n) — internal only, never customer-facing ---
N8N_BASE_URL=https://workflow.flowmolabs.com
N8N_API_KEY=<n8n-api-key>

# --- Stripe (use LIVE keys in production) ---
STRIPE_SECRET_KEY=sk_live_<live-secret-key>
# From the LIVE webhook endpoint you create at:
#   https://dashboard.stripe.com/webhooks  → add  https://bookmycab.io/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_<live-endpoint-signing-secret>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_<live-publishable-key>

# --- Voice call metering (B5) — bearer secret for the call-ingest endpoint ---
# The voice provider authenticates POSTs to /api/voice/calls/ingest with this.
# Generate a long random string, e.g.  openssl rand -hex 32
VOICE_INGEST_SECRET=<random-32-byte-hex>

# --- Resend (transactional email) ---
RESEND_API_KEY=re_<resend-api-key>
RESEND_FROM_EMAIL=team@bookmycab.io                        # must be a verified domain

# --- Upstash Redis (hosted REST) ---
UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<upstash-rest-token>

# --- Marketing (NEXT_PUBLIC_* → inlined at BUILD time) ---
# Cal.com booking slug for the "Book a Discovery Call" popup (public link, no key).
NEXT_PUBLIC_CAL_LINK=bookmycab/discovery
NEXT_PUBLIC_SITE_URL=https://bookmycab.io

# --- App config ---
WEBHOOK_RATE_LIMIT_PER_MIN=60
DEMO_TENANT_ID=<demo-tenant-uuid-or-leave-blank>
# Password for the read-only tenant demo login (min 8 chars).
DEMO_SESSION_SECRET=<demo-session-password>
# Must match the Supabase JWT hook that marks staff (email domain → is_flowmo_staff).
FLOWMO_STAFF_EMAIL_DOMAIN=flowmoai.com
