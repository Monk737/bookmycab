{"nodes": [{"id": "migrations_0010_vault_rpc_wrappers", "label": "Migration 0010: vault RPC wrapper functions", "file_type": "code", "source_file": "supabase/migrations/0010_vault_rpc_wrappers.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgREST runs every request on its own pooled connection so a separate set_config call cannot share a session. Wrappers accept the key as a parameter and set_config transaction-locally inside the same function body, ensuring the inner vault function sees the key in one PostgREST call = one transaction."}, {"id": "migrations_0010_vault_store_credential_rpc", "label": "vault_store_credential_rpc function (SECURITY INVOKER)", "file_type": "code", "source_file": "supabase/migrations/0010_vault_rpc_wrappers.sql", "source_location": "line 35", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wraps vault_store_credential to accept encryption key as parameter; sets it transaction-locally before delegating. REVOKE from PUBLIC/anon/authenticated is the real caller gate."}, {"id": "migrations_0010_vault_read_credential_rpc", "label": "vault_read_credential_rpc function (SECURITY INVOKER)", "file_type": "code", "source_file": "supabase/migrations/0010_vault_rpc_wrappers.sql", "source_location": "line 57", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reads encrypted credential by setting key transaction-locally via set_config before calling inner SECURITY DEFINER vault_read_credential."}, {"id": "migrations_0010_vault_rotate_credential_rpc", "label": "vault_rotate_credential_rpc function (SECURITY DEFINER)", "file_type": "code", "source_file": "supabase/migrations/0010_vault_rpc_wrappers.sql", "source_location": "line 78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Re-encrypts an existing credential row in-place using pgp_sym_encrypt. current_user guard + REVOKE are the dual access controls."}, {"id": "migrations_0010_vault_revoke_grants", "label": "vault RPC REVOKE EXECUTE from PUBLIC/anon/authenticated", "file_type": "code", "source_file": "supabase/migrations/0010_vault_rpc_wrappers.sql", "source_location": "line 111", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The REVOKE is the actual caller gate; the inner current_user check runs as the function owner (postgres) and does NOT screen the wrapper caller. Only service_role/postgres/supabase_admin retain EXECUTE."}], "edges": [{"source": "migrations_0010_vault_store_credential_rpc", "target": "epic3_task6_credentials_vault", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "supabase/migrations/0010_vault_rpc_wrappers.sql", "source_location": null, "weight": 1.0}, {"source": "migrations_0010_vault_read_credential_rpc", "target": "epic3_task6_credentials_vault", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "supabase/migrations/0010_vault_rpc_wrappers.sql", "source_location": null, "weight": 1.0}, {"source": "migrations_0010_vault_rotate_credential_rpc", "target": "epic3_task6_credentials_vault", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "supabase/migrations/0010_vault_rpc_wrappers.sql", "source_location": null, "weight": 1.0}, {"source": "migrations_0010_vault_revoke_grants", "target": "migrations_0010_vault_store_credential_rpc", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "supabase/migrations/0010_vault_rpc_wrappers.sql", "source_location": null, "weight": 0.9}, {"source": "migrations_0010_vault_rpc_wrappers", "target": "env_ts_supabase_vault_key", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "supabase/migrations/0010_vault_rpc_wrappers.sql", "source_locat