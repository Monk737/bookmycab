{"nodes": [{"id": "middleware_access_claims", "label": "Claims", "file_type": "code", "source_file": "src/middleware/access.ts", "source_location": "1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "middleware_access_accessdecision", "label": "AccessDecision", "file_type": "code", "source_file": "src/middleware/access.ts", "source_location": "9", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "middleware_access_public_pages", "label": "PUBLIC_PAGES", "file_type": "code", "source_file": "src/middleware/access.ts", "source_location": "16", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "middleware_access_auth_routes", "label": "AUTH_ROUTES", "file_type": "code", "source_file": "src/middleware/access.ts", "source_location": "23", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "middleware_access_parseclaims", "label": "parseClaims", "file_type": "code", "source_file": "src/middleware/access.ts", "source_location": "29", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "middleware_access_evaluateaccess", "label": "evaluateAccess", "file_type": "code", "source_file": "src/middleware/access.ts", "source_location": "49", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rationale_mfa_aware_route_gate", "label": "MFA-Aware Route Gate Rationale", "file_type": "rationale", "source_file": "src/middleware/access.ts", "source_location": "56-65", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owner and Admin roles require aal2 (MFA verified) to access any protected route. Viewer is exempt because MFA is optional for read-only roles. AUTH_ROUTES (/login, /forgot-password, /reset-password, /accept-invite, /mfa) are always reachable even at aal1 to prevent redirect loops where the middleware redirects to /mfa but /mfa itself is blocked."}, {"id": "rationale_parseclaims_shared_jwt_parser", "label": "parseClaims \u2014 Shared JWT\u2192Claims Parser", "file_type": "rationale", "source_file": "src/middleware/access.ts", "source_location": "29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "parseClaims is the single canonical function that maps a raw JWT payload (Record<string,unknown>) to the typed Claims shape. It is intentionally pure and side-effect free so it can be called both inside the Next.js edge middleware (for routing decisions) and inside server-side session helpers (getCurrentClaims). This avoids duplicating JWT field extraction logic and ensures the Claims type is always authoritative."}, {"id": "middleware_access_evaluate_access", "label": "evaluateAccess() \u2014 pure route policy function", "file_type": "code", "source_file": "src/middleware/access.ts", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "middleware_access_auth_routes", "label": "AUTH_ROUTES constant", "file_type": "code", "source_file": "src/middleware/access.ts", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "rationale_mfa_aware_route_gate", "target": "middleware_access_evaluateaccess", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "src/middleware/access.ts", "source_location": "56-65", "weight": 1.0}, {"source": "rationale_mfa_aware_route_gate", "target": "middleware_access_auth_routes", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "src/middleware/access.ts", "source_location": "23", "weight": 1.0}, {"source": "rationale_parseclaims_shared_jwt_parser", "target": "middleware_access_parseclaims", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "src/middleware/access.ts", "source_location": "29", "weight": 1.0}, {"source": "middleware_access_evaluateaccess", "target": "middleware_access_parseclaims", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/middleware/access.ts", "source_location": "49", "weight": 0.9}, {"source": "middleware_access_evaluateaccess", "target": "middleware_access_accessdecision", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/middleware/access.ts", "source_location": "49", "weight": 1.0}], "hyperedges": []}